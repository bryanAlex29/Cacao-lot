{
  "name": "cacaosmart-iot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "setup:auth-env": "node scripts/setup-auth-env.mjs",
    "admin:create": "node scripts/bootstrap-admin.mjs",
    "simulator:provision": "node scripts/simulator-provision.mjs",
    "simulator": "node scripts/simulator.mjs",
    "test:simulator": "node --test scripts/simulator.test.mjs",
    "iot:check": "node scripts/iot-contract-check.mjs",
    "test:iot-contract": "node --test scripts/iot-contract.test.mjs",
    "test:dependency-security": "node --test scripts/dependency-security.test.mjs",
    "test:backup": "node --test scripts/backup-restore.test.mjs",
    "test:backup:integration": "node --test scripts/backup-bundle.integration.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:create": "node scripts/create-backup.mjs",
    "backup:neon": "node scripts/neon-backup.mjs",
    "test:backup:neon": "node --test scripts/neon-postgres.test.mjs",
    "backup:periodic": "node scripts/periodic-backup.mjs",
    "test:backup:periodic": "node --test scripts/periodic-backup.test.mjs",
    "backup:copy": "node scripts/copy-backup.mjs",
    "test:backup:copy": "node --test scripts/backup-copy.test.mjs",
    "prediction:demo": "node scripts/prediction-baseline.mjs --demo",
    "prediction:baseline": "node scripts/prediction-baseline.mjs",
    "test:prediction-cli": "node --test scripts/prediction-baseline.test.mjs",
    "prediction:regression:demo": "node scripts/prediction-regression.mjs --demo",
    "prediction:regression": "node scripts/prediction-regression.mjs",
    "prediction:publish": "node scripts/publish-regression.mjs",
    "test:regression-python": "node scripts/test-regression-python.mjs",
    "test:regression-cli": "node --test scripts/prediction-regression.test.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "test:integration:neon": "node scripts/neon-integration.mjs",
    "test:browser:neon": "node scripts/neon-integration.mjs --browser",
    "test:browser": "node scripts/integration-test.mjs --browser",
    "dev:frontend": "npm run start --workspace=@cacaosmart/frontend",
    "dev:backend": "npm run start:dev --workspace=@cacaosmart/backend",
    "build": "npm run build --workspace=@cacaosmart/backend && npm run build --workspace=@cacaosmart/frontend",
    "lint": "eslint frontend/src backend packages scripts eslint.config.mjs",
    "format:check": "prettier --check frontend backend packages scripts package.json docker-compose.yml eslint.config.mjs .prettierrc.json README.md docs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@cacaosmart/backend && npm run test --workspace=@cacaosmart/frontend",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:generate": "npm run prisma:generate --workspace=@cacaosmart/backend",
    "db:validate": "npm run prisma:validate --workspace=@cacaosmart/backend",
    "db:migrate": "npm run prisma:migrate --workspace=@cacaosmart/backend",
    "smoke": "node scripts/smoke.mjs",
    "ops:check": "node scripts/operations-check.mjs",
    "ops:health": "node scripts/operations-health.mjs",
    "ops:backup": "node scripts/operations-backup.mjs",
    "test:operations": "node --test scripts/operations.test.mjs",
    "local:start": "node scripts/local-session.mjs",
    "local:check": "node scripts/operations-check.mjs",
    "local:health": "node scripts/operations-health.mjs --base-url http://127.0.0.1:3100",
    "test:local-session": "node --test scripts/local-session.test.mjs",
    "simulation:preview": "node scripts/simulation-preview.mjs",
    "test:simulation-scenarios": "node --test scripts/simulation-scenarios.test.mjs"
  },
  "overrides": {
    "@prisma/config@7.10.1": {
      "effect": "3.22.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
