# Candidato de UN solo host con proxy HTTPS y API en loopback.
# Plantilla sin secretos; NO sustituye .env ni se activa al copiarla.
# Revisar docs/operations.md. Valores de ejemplo impiden aprobar la revisión.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
CORS_ORIGIN=https://cacao.example.invalid
DATABASE_URL=
JWT_SECRET=
TELEMETRY_MODE=real
AI_PROVIDER=disabled
WEATHER_PROVIDER=disabled
WEATHER_NONCOMMERCIAL_CONFIRMED=false
AI_MAX_IMAGE_MB=8
AI_DAILY_LIMIT_PER_USER=5
AI_REQUEST_TIMEOUT_MS=10000
IMAGE_RETENTION_DAYS=7
# Definir ruta ABSOLUTA privada y persistente, fuera de la carpeta de release.
# IMAGE_STORAGE_PATH=
