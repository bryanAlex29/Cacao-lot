{
  "name": "@cacaosmart/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nodemon --config nodemon.json",
    "test": "jest --runInBand",
    "thingspeak:check": "node --env-file=../.env -r ts-node/register src/integrations/thingspeak-check.ts",
    "thingspeak:provision": "ts-node src/integrations/thingspeak-provision.ts",
    "thingspeak:import-once": "node --env-file=../.env -r ts-node/register src/integrations/thingspeak-import-once.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "node --env-file=../.env ../node_modules/prisma/build/index.js validate",
    "prisma:migrate": "node --env-file=../.env ../node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@cacaosmart/contracts": "0.1.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "nodemon": "3.1.11",
    "playwright-core": "^1.58.2",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2"
  }
}
