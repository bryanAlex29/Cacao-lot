# Generar .env local con npm run setup:env. No versionar secretos reales.
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
CORS_ORIGIN=http://localhost:4200
POSTGRES_USER=cacaosmart
POSTGRES_DB=cacaosmart
POSTGRES_PORT=5433
POSTGRES_PASSWORD=
DATABASE_URL=
# real por defecto; demo habilita canal/consultas demo explícitos solo fuera de producción.
# El simulador se provisiona/ejecuta por CLI; esta variable no crea recursos.
TELEMETRY_MODE=real
# 32 bytes aleatorios en hexadecimal (64 caracteres). Generado por setup:env.
JWT_SECRET=
# Solo para CLI local admin:create; completar temporalmente y retirar tras el alta.
# Contraseña: 8–128 caracteres, al menos una mayúscula y un símbolo.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
