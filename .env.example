# Generar .env local con npm run setup:env. No versionar secretos reales.
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
CORS_ORIGIN=http://localhost:4200
POSTGRES_USER=cacaosmart
POSTGRES_DB=cacaosmart
POSTGRES_PORT=5433
POSTGRES_PASSWORD=
DATABASE_URL=
# real por defecto; demo habilita canal/consultas demo explícitos solo fuera de producción.
# El simulador se provisiona/ejecuta por CLI; esta variable no crea recursos.
TELEMETRY_MODE=real
# 32 bytes aleatorios en hexadecimal (64 caracteres). Generado por setup:env.
JWT_SECRET=
# Solo para CLI local admin:create; completar temporalmente y retirar tras el alta.
# Contraseña: 8–128 caracteres, al menos una mayúscula y un símbolo.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Diagnóstico fotográfico local simulado, sin OpenAI ni costos.
# Omitir AI_PROVIDER: mock en desarrollo/test, disabled en producción.
# No habilitar mock en producción. Este incremento no admite proveedor real.
AI_PROVIDER=mock
AI_MAX_IMAGE_MB=8
AI_DAILY_LIMIT_PER_USER=5
AI_REQUEST_TIMEOUT_MS=10000
IMAGE_RETENTION_DAYS=7
# Opcional: directorio privado del servidor, nunca un directorio público Angular.
# Por defecto .local/ai-images desde la raíz del repositorio, ignorado por Git.
# IMAGE_STORAGE_PATH=
# Clima actual/ciudades e histórico ERA5: disabled por defecto, sin actividad externa.
# Activar open-meteo SOLO tras confirmar uso no comercial.
# Perfil de parcela: requiere consentimiento; ciudad: búsqueda/selección explícitas, sin guardar perfil.
WEATHER_PROVIDER=disabled
WEATHER_NONCOMMERCIAL_CONFIRMED=false

# ThingSpeak: lectura explícita desde backend; sin polling ni mapeo automático.
# Channel ID numérico. Dejar vacío no afecta el arranque de la aplicación.
THINGSPEAK_CHANNEL_ID=
# Solo Read API Key (vacía en canales públicos). NUNCA usar Write API Key.
THINGSPEAK_READ_API_KEY=
# Activar tras provisión explícita; solo development. Sin vínculo privado no importa.
THINGSPEAK_IMPORT_ENABLED=false
